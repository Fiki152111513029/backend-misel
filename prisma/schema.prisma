generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(uuid())
  username                  String                     @unique
  email                     String?                    @unique
  password                  String
  fullName                  String
  roleId                    String
  isActive                  Boolean                    @default(true)
  priority                  Int                        @default(6)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  // "Deleting" a user soft-deletes them (like every other entity in this
  // app) instead of a hard DB delete — Task/WarehouseCartTask/ProductionLine/
  // WarehouseOperatorLocation keep a required, non-nullable operatorId FK to
  // preserve full audit history, so the referenced User row must keep
  // existing. Related records for that user are cascaded to deletedAt too.
  deletedAt                 DateTime?
  role                      Role                       @relation(fields: [roleId], references: [id])
  refreshTokens             RefreshToken[]
  warehouseOperatorLocation WarehouseOperatorLocation?
  productionLines           ProductionLine[]
  tasks                     Task[]
  warehouseCartTasks        WarehouseCartTask[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id                  String   @id @default(uuid())
  userId              String
  tokenHash           String   @unique
  revoked             Boolean  @default(false)
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  replacedByTokenHash String?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model BoxType {
  id               String     @id @default(uuid())
  name             String
  ordering         Int
  colorCode        String
  modelProcessCode String     @default("")
  fromSystem       FromSystem @default(MES)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  requestBoxes RequestBox[]
  tasks        Task[]

  // `name` uniqueness is enforced by a partial unique index (WHERE "deletedAt"
  // IS NULL, see migration) so a soft-deleted row's name can be reused.
  @@index([name])
  @@map("box_types")
}

enum FromSystem {
  MES
  WMS
}

model ModelCodeProcess {
  id             String      @id @default(uuid())
  name           String
  fromSystem     FromSystem  @default(MES)
  isActive       Boolean     @default(true)
  statusComment1 String      @default("")
  statusComment2 String      @default("")
  statusComment3 String      @default("")
  statusComment4 String      @default("")
  statusComment5 String      @default("")
  statusComment6 String      @default("")
  statusComment7 String      @default("")
  statusComment8 String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  warehouseLineLocations WarehouseLineLocation[]
  warehouseCartTasks     WarehouseCartTask[]
  productionLineAreas    ProductionLineArea[]
  quarantineLines        QuarantineLine[]

  // `name` uniqueness is enforced by a partial unique index (WHERE "deletedAt"
  // IS NULL, see migration) so a soft-deleted row's name can be reused.
  @@index([name])
  @@map("model_code_processes")
}

model QuarantineLine {
  id                 String           @id @default(uuid())
  name               String
  isActive           Boolean          @default(true)
  modelCodeProcessId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  modelCodeProcess   ModelCodeProcess? @relation(fields: [modelCodeProcessId], references: [id])
  quarantineAreas    QuarantineArea[]
  productionLines    ProductionLine[]

  // `name` uniqueness is enforced by a partial unique index (WHERE "deletedAt"
  // IS NULL, see migration) so a soft-deleted row's name can be reused.
  @@index([name])
  @@index([modelCodeProcessId])
  @@map("quarantine_lines")
}

model QuarantineArea {
  id                  String         @id @default(uuid())
  name                String
  iRaypleLocationCode String
  quarantineLineId    String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?
  quarantineLine      QuarantineLine @relation(fields: [quarantineLineId], references: [id])
  tasks               Task[]

  // `iRaypleLocationCode` uniqueness is enforced by a partial unique index
  // (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted row's code
  // can be reused.
  @@index([iRaypleLocationCode])
  @@index([quarantineLineId])
  @@map("quarantine_areas")
}

model EximLocation {
  id                  String    @id @default(uuid())
  name                String
  iRaypleLocationCode String
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  productionLineAreas ProductionLineArea[]

  // `name`/`iRaypleLocationCode` uniqueness is enforced by partial unique
  // indexes (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted
  // row's name/code can be reused.
  @@index([name])
  @@index([iRaypleLocationCode])
  @@map("exim_locations")
}

model EmptyPalletLocation {
  id                  String    @id @default(uuid())
  name                String
  iRaypleLocationCode String
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  productionLineAreas ProductionLineArea[]

  // `name`/`iRaypleLocationCode` uniqueness is enforced by partial unique
  // indexes (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted
  // row's name/code can be reused.
  @@index([name])
  @@index([iRaypleLocationCode])
  @@map("empty_pallet_locations")
}

model WarehouseLineLocation {
  id                   String    @id @default(uuid())
  name                 String
  droppingLocationCode String
  pickingLocationCode  String
  modelCodeProcessId   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  modelCodeProcess   ModelCodeProcess?   @relation(fields: [modelCodeProcessId], references: [id])
  warehouseCartTasks WarehouseCartTask[]

  // `name`/`droppingLocationCode`/`pickingLocationCode` uniqueness is enforced
  // by partial unique indexes (WHERE "deletedAt" IS NULL, see migration) so a
  // soft-deleted row's name/code can be reused.
  @@index([name])
  @@index([droppingLocationCode])
  @@index([pickingLocationCode])
  @@index([modelCodeProcessId])
  @@map("warehouse_line_locations")
}

model WarehouseOperatorLocation {
  id           String    @id @default(uuid())
  name         String
  locationCode String
  operatorId   String    @unique
  operator     User      @relation(fields: [operatorId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // `name`/`locationCode` uniqueness is enforced by partial unique indexes
  // (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted row's
  // name/code can be reused. `operatorId` stays fully unique since the
  // User 1:1 relation depends on it.
  @@index([name])
  @@index([locationCode])
  @@map("warehouse_operator_locations")
}

enum WarehouseCartTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model WarehouseCartTask {
  id                      String                  @id @default(uuid())
  taskId                  String                  @unique
  taskPath                String
  status                  WarehouseCartTaskStatus @default(PENDING)
  warehouseLineLocationId String
  modelCodeProcessId      String
  robotId                 String?
  operatorId              String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  warehouseLineLocation   WarehouseLineLocation   @relation(fields: [warehouseLineLocationId], references: [id])
  modelCodeProcess        ModelCodeProcess        @relation(fields: [modelCodeProcessId], references: [id])
  robot                   Robot?                  @relation(fields: [robotId], references: [id])
  operator                User                    @relation(fields: [operatorId], references: [id])

  @@index([warehouseLineLocationId])
  @@index([modelCodeProcessId])
  @@index([robotId])
  @@index([operatorId])
  @@map("warehouse_cart_tasks")
}

model ProductionLine {
  id                 String               @id @default(uuid())
  name               String
  quarantineLineId   String
  operatorId         String
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  quarantineLine     QuarantineLine       @relation(fields: [quarantineLineId], references: [id])
  operator           User                 @relation(fields: [operatorId], references: [id])
  productionLineAreas ProductionLineArea[]
  requestBoxes        RequestBox[]
  tasks               Task[]

  // `name` uniqueness is enforced by a partial unique index (WHERE "deletedAt"
  // IS NULL, see migration) so a soft-deleted row's name can be reused.
  @@index([name])
  @@index([quarantineLineId])
  @@index([operatorId])
  @@map("production_lines")
}

enum ProductionLineAreaType {
  PRODUCTION
  STOCK
}

model ProductionLineArea {
  id                    String                 @id @default(uuid())
  name                  String
  type                  ProductionLineAreaType
  iRaypleLocationCode   String
  productionLineId      String
  eximLocationId        String
  emptyPalletLocationId String
  modelCodeProcessId    String?
  order                 Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  productionLine        ProductionLine         @relation(fields: [productionLineId], references: [id])
  eximLocation          EximLocation           @relation(fields: [eximLocationId], references: [id])
  emptyPalletLocation   EmptyPalletLocation    @relation(fields: [emptyPalletLocationId], references: [id])
  modelCodeProcess      ModelCodeProcess?      @relation(fields: [modelCodeProcessId], references: [id])
  tasks                 Task[]

  // `iRaypleLocationCode` uniqueness is enforced by a partial unique index
  // (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted row's code
  // can be reused — this is the exact bug this migration fixes.
  @@index([iRaypleLocationCode])
  @@index([productionLineId])
  @@index([eximLocationId])
  @@index([emptyPalletLocationId])
  @@index([modelCodeProcessId])
  @@map("production_line_areas")
}

model RequestBox {
  id               String    @id @default(uuid())
  productionLineId String
  boxTypeId        String
  qty              Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  productionLine   ProductionLine @relation(fields: [productionLineId], references: [id])
  boxType          BoxType        @relation(fields: [boxTypeId], references: [id])

  @@index([productionLineId])
  @@index([boxTypeId])
  @@map("request_boxes")
}

enum RobotState {
  IDLE
  INITIALIZING
  IN_TASK
  FAULT
  OFFLINE
  CHARGING
  UPGRADING
}

model Robot {
  id                String     @id @default(uuid())
  name              String
  amrDeviceSerialNo String
  amrDeviceNo       String
  areaId            Int
  speed             Float      @default(0)
  battery           Int        @default(0)
  state             RobotState @default(OFFLINE)
  lastUpdate        DateTime   @default(now())
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  tasks             Task[]
  warehouseCartTasks WarehouseCartTask[]
  activityLogs      RobotActivityLog[]

  // `name`/`amrDeviceSerialNo`/`amrDeviceNo` uniqueness is enforced by
  // partial unique indexes (WHERE "deletedAt" IS NULL, see migration) so a
  // soft-deleted row's name/code can be reused.
  @@index([name])
  @@index([amrDeviceSerialNo])
  @@index([amrDeviceNo])
  @@map("robots")
}

// A snapshot of a robot's live telemetry (from ROBOT_TELEMETRY_URL, the same
// device-info API already polled for the Robots list) — recorded as a side
// effect each time that telemetry is fetched, so viewing/refreshing the
// Robots page is what builds up this history over time.
model RobotActivityLog {
  id          String   @id @default(uuid())
  robotId     String?
  deviceCode  String
  deviceName  String
  speed       Float?
  battery     Int?
  status      Int?
  state       String?
  position    String?
  payload     String?
  orientation Float?
  recordedAt  DateTime @default(now())
  robot       Robot?   @relation(fields: [robotId], references: [id])

  @@index([robotId])
  @@index([recordedAt])
  @@map("robot_activity_logs")
}

model FactoryMap {
  id         String @id @default(uuid())
  name       String
  // Manually assigned by whoever creates the map (starts at 1) — this is
  // the areaId Robots use to talk to the AMR fleet API, so it must be
  // unique. Nullable only because existing maps predate this field; new
  // maps are required to set it (see CreateFactoryMapDto).
  areaNumber Int?
  // Server-relative URLs under /uploads — the actual files live on disk,
  // not in the DB. imagePath is optional — some maps only have topology
  // data with no floor-plan raster to show behind it.
  imagePath    String?
  topologyPath String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // `name`/`areaNumber` uniqueness is enforced by partial unique indexes
  // (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted row's
  // values can be reused, matching the rest of the app's soft-delete
  // convention. Multiple NULL areaNumbers are allowed under that index.
  @@index([name])
  @@index([areaNumber])
  @@map("factory_maps")
}

model ChargerArea {
  id                  String    @id @default(uuid())
  name                String
  iRaypleLocationCode String
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // `name`/`iRaypleLocationCode` uniqueness is enforced by partial unique
  // indexes (WHERE "deletedAt" IS NULL, see migration) so a soft-deleted
  // row's name/code can be reused.
  @@index([name])
  @@index([iRaypleLocationCode])
  @@map("charger_areas")
}

enum TaskAction {
  AMBIL_FG
  NOT_STANDARD
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Task {
  id                   String              @id @default(uuid())
  taskId               String              @unique
  taskAction           TaskAction
  taskPath             String
  status               TaskStatus          @default(PENDING)
  productionLineId     String
  productionLineAreaId String?
  quarantineAreaId     String?
  boxTypeId            String
  robotId              String?
  operatorId           String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  productionLine       ProductionLine      @relation(fields: [productionLineId], references: [id])
  productionLineArea   ProductionLineArea? @relation(fields: [productionLineAreaId], references: [id])
  quarantineArea       QuarantineArea?     @relation(fields: [quarantineAreaId], references: [id])
  boxType              BoxType             @relation(fields: [boxTypeId], references: [id])
  robot                Robot?              @relation(fields: [robotId], references: [id])
  operator             User                @relation(fields: [operatorId], references: [id])

  @@index([productionLineId])
  @@index([productionLineAreaId])
  @@index([quarantineAreaId])
  @@index([boxTypeId])
  @@index([robotId])
  @@index([operatorId])
  @@map("tasks")
}

// Raw log of every inbound call to our ICS webhook receiver (RCS actively
// reporting task status — see docs/apiwebhook.md), regardless of whether we
// could match it to one of our own tasks. Kept for the "Webhook Logs" page
// and as an audit trail independent of our own Task/WarehouseCartTask state.
model WebhookLog {
  id              String   @id @default(uuid())
  method          String
  endpoint        String
  requestPayload  Json
  responsePayload Json
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("webhook_logs")
}
