# App
PORT=3001

# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:fiki1234@localhost:5432/db_misel?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Seed bootstrap Super Admin (change the password immediately after first login!)
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_FULLNAME="Super Administrator"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

ROBOT_TELEMETRY_URL="http://172.18.101.10:7000/ics/out/device/list/deviceInfo"
ROBOT_TELEMETRY_DEVICE_TYPE="0"
