# App
PORT=3000

# PostgreSQL / Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/misel?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Password hashing=s

BCRYPT_SALT_ROUNDS=10

# interface name: http://IP:7000/ics/out/controlDevice Restore dan Suspend
# Interface name: http://IP:7000/ics/out/task/continueTask Suspend

# Seed bootstrap Super Admin (change the password immediately after first login!)
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_EMAIL="superadmin@example.com"
SEED_SUPER_ADMIN_FULLNAME="Super Administrator"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Robot telemetry (external AMR fleet API, POST {areaId, deviceType}, merged into
# GET /robots by matching deviceCode/deviceName against amrDeviceSerialNo/amrDeviceNo) Info robot ditable robot
ROBOT_TELEMETRY_URL="http://172.5.23.90:7000/ics/out/device/list/deviceInfo"
ROBOT_TELEMETRY_DEVICE_TYPE="0"

# Robot control (external AMR fleet API, POST {areaId, deviceNumber, controlWay})
# — triggered by the Robots table's Susp (0) / Rest (1) buttons
ROBOT_CONTROL_URL="http://172.5.23.90:7000/ics/out/controlDevice"

# Factory map topology (external AMR fleet API, POST {areaId}) — returns
# { mapId, mapJsonUrl, mapZipUrl }; mapJsonUrl is fetched server-side and its
# path/charger data is served to the Dashboard's Factory Map card.
# Uses the same TASK_ORDER_AREA_ID as the rest of the RCS integration.
ROBOT_TOPOLOGY_URL="http://172.5.23.90:7000/ics/out/topologyList"

# Task order submission (external AMR fleet API, POST {modelProcessCode, priority,
# fromSystem, orderId, taskOrderDetail}) — triggered by Mainline "Release Task" menjalankan task warehouse dan operator
TASK_ORDER_URL="http://172.5.23.90:7000/ics/taskOrder/addTask"

# Task order live status (external AMR fleet API, POST {areaId}), merged into
# GET /tasks by matching OrderId against our own taskId
TASK_ORDER_GET_ORDER_LIST_URL="http://172.5.23.90:7000/ics/out/task/getOrderList"
TASK_ORDER_AREA_ID="2"

# Extra password gate in front of the ICS Logs pages (API Logs / Webhook Logs)
# for developer troubleshooting — required on every visit, on top of normal login.
ICS_LOGS_DEVELOPER_PASSWORD="change-me-ics-logs-password"



Area ID: Provided by the
integrated control system.
This field is mainly used to
distinguish warehouses or
areas. The default value is 1.


Device ID. The device ID is
null if all devices in the area
are to be suspended or
restored devices are
separated by commas.

all Int 2 No
Whether to suspend or
restore all devices in the
area
0: Not all
1: All

controlWay Int 2 Yes 0: Suspend device
1: Restore device